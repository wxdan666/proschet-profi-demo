        "Приостановлен"
    ],
    "order_statuses": [
        "Новая",
        "В работе",
        "Выполнена",
        "Отменена"
    ],
    "material_categories": [
        "Металлопрокат",
        "Метизы и фурнитура",
        "Сварочные материалы",
        "Абразив и инструмент",
        "Лакокрасочные материалы",
        "Электротехника",
        "Строительные смеси",
        "Прочее"
    ],
    "backup": {
        "dir": "backups",
        "keep": 14
